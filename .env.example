# ─── DustOps Environment Configuration ───────────────────
#
# Copy this file to '.env' and populate with your own production secrets.
# NEVER commit your actual '.env' file to version control.

# ── Discord Bot Credentials ──────────────────────────────
# Token obtained from Discord Developer Portal (Applications -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord User ID of the primary administrator / owner for exclusive DM alerts & control
OWNER_USER_ID=123456789012345678

# ── Core Agent REST API ──────────────────────────────────
# Bind host (0.0.0.0 for public/network access, 127.0.0.1 for local/tunnel only)
API_HOST=0.0.0.0
API_PORT=4141

# ── Security & Authentication ────────────────────────────
# Credentials for accessing the Web Dashboard and protecting REST API endpoints
WEB_USERNAME=admin
WEB_PASSWORD=change_this_to_a_strong_password

# ── Process Watchdog Engine ──────────────────────────────
# Keyword matchers for automatic process tracking (comma-separated)
WATCH_KEYWORDS=node,python,uvicorn,gunicorn,next-server

# Port listeners to monitor (comma-separated)
WATCH_PORTS=3000,5173,8000,8080,8081

# Interval in seconds between background process differential scans
WATCHDOG_INTERVAL=5

# Interval in seconds between automated Discord DM dashboard embed updates
DASHBOARD_INTERVAL=3600
